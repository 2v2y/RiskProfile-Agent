{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "profile_schema.json",
  "title": "画像输入卡（Profile Card）",
  "description": "定义智能模块可读取的动态风险画像字段（对应研究方案 8.6/8.7 表6）。带 x-pending-delivery=true 的字段等学生3下一版画像卡交付后转为 required；白名单以 configs/agent_profile_whitelist.json 为准。",
  "type": "object",
  "required": [
    "sample_id",
    "quarter",
    "ranking_cutoff",
    "profile_version",
    "industry_group",
    "history_inspections",
    "history_positive_inspections",
    "smoothed_positive_rate",
    "days_since_last_inspection",
    "days_since_last_positive",
    "inspections_365d",
    "positives_365d",
    "inspections_730d",
    "positives_730d",
    "decayed_inspections",
    "decayed_positives",
    "no_history_flag",
    "no_positive_history_flag",
    "missing_last_inspection_flag",
    "missing_last_positive_flag",
    "entity_match_uncertain_flag",
    "insufficient_evidence_flag"
  ],
  "additionalProperties": false,
  "properties": {
    "sample_id": { "type": "string", "description": "匿名样本编号" },
    "quarter": { "type": "string", "pattern": "^[0-9]{4}Q[1-4]$", "description": "所属季度，如 2024Q2" },
    "ranking_cutoff": { "type": "string", "format": "date", "description": "画像截止日，只允许使用该日期前已公开的信息" },
    "profile_version": { "type": "string", "description": "画像规则版本" },
    "industry_group": { "type": "string", "enum": ["G1", "G2", "G3", "G4", "UNKNOWN"], "description": "行业组：G1=221122，G2=其他发电输电配电，G3=237130，G4=238210，UNKNOWN=无成熟历史/无法判定" },
    "jurisdiction_context": { "type": "string", "description": "监管背景（州计划/联邦）", "x-pending-delivery": true },
    "quarter_number": { "type": "integer", "minimum": 1, "description": "自然季度序号（Context 特征，M2 模型也使用）" },
    "history_inspections": { "type": "integer", "minimum": 0, "description": "历史检查次数" },
    "history_positive_inspections": { "type": "integer", "minimum": 0, "description": "历史签发违章记录的检查次数" },
    "smoothed_positive_rate": { "type": "number", "minimum": 0, "maximum": 1, "description": "平滑历史比例（无历史时为0.5，仅计算用初始值）" },
    "days_since_last_inspection": { "type": ["number", "null"], "minimum": 0, "description": "距最近一次可用检查天数；缺失保留 null 并置 missing_last_inspection_flag" },
    "days_since_last_positive": { "type": ["number", "null"], "minimum": 0, "description": "距最近一次签发违章记录的检查天数；缺失保留 null 并置 missing_last_positive_flag" },
    "inspections_365d": { "type": "integer", "minimum": 0, "description": "近365天成熟历史检查数 [t-365, t)" },
    "positives_365d": { "type": "integer", "minimum": 0, "description": "近365天签发违章记录的历史检查数" },
    "inspections_730d": { "type": "integer", "minimum": 0, "description": "近730天成熟历史检查数 [t-730, t)" },
    "positives_730d": { "type": "integer", "minimum": 0, "description": "近730天签发违章记录的历史检查数" },
    "decayed_inspections": { "type": "number", "minimum": 0, "description": "衰减后的历史检查量（越近权重越大）" },
    "decayed_positives": { "type": "number", "minimum": 0, "description": "衰减后的违章记录量" },
    "historical_standard_codes": { "type": "array", "items": { "type": "string" }, "description": "历史OSHA标准编号", "x-pending-delivery": true },
    "historical_risk_categories": { "type": "array", "items": { "type": "string", "pattern": "^R[1-9]$" }, "description": "历史风险类别 R1—R9", "x-pending-delivery": true },
    "risk_category_counts": {
      "type": "object",
      "description": "各风险类别出现次数",
      "x-pending-delivery": true,
      "properties": {
        "R1": { "type": "integer", "minimum": 0 },
        "R2": { "type": "integer", "minimum": 0 },
        "R3": { "type": "integer", "minimum": 0 },
        "R4": { "type": "integer", "minimum": 0 },
        "R5": { "type": "integer", "minimum": 0 },
        "R6": { "type": "integer", "minimum": 0 },
        "R7": { "type": "integer", "minimum": 0 },
        "R8": { "type": "integer", "minimum": 0 },
        "R9": { "type": "integer", "minimum": 0 },
        "unmapped": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "risk_category_unmapped_rate": { "type": "number", "minimum": 0, "maximum": 1, "description": "风险类别未映射比例", "x-pending-delivery": true },
    "risk_score": { "type": "number", "description": "固定M2模型风险分数", "x-pending-delivery": true },
    "risk_percentile": { "type": "number", "minimum": 0, "maximum": 1, "description": "季度内风险分位", "x-pending-delivery": true },
    "model_version": { "type": "string", "description": "风险模型版本", "x-pending-delivery": true },
    "score_evidence": { "type": "string", "description": "风险分数来源（模型文件版本与SHA-256）", "x-pending-delivery": true },
    "no_history_flag": { "type": "boolean", "description": "没有历史检查记录" },
    "no_positive_history_flag": { "type": "boolean", "description": "没有签发违章记录的历史检查" },
    "missing_last_inspection_flag": { "type": "boolean", "description": "缺少最近检查日期" },
    "missing_last_positive_flag": { "type": "boolean", "description": "缺少最近违章记录检查日期" },
    "entity_match_uncertain_flag": { "type": "boolean", "description": "单位匹配存在不确定性" },
    "insufficient_evidence_flag": { "type": "boolean", "description": "可用依据不足，应转人工或停止生成" }
  }
}
