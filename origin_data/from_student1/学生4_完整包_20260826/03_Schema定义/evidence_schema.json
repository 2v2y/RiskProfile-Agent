{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence_schema.json",
  "title": "法规证据（Retrieval Agent 输出）",
  "description": "法规检索模块输出与证据账本引用的统一格式（对应研究方案 10.2 表9、14.3、表11）。证据引用键格式：regulation:<document_id>#<section>。",
  "type": "object",
  "required": ["query_id", "standard_number", "risk_categories", "items", "empty_reason"],
  "additionalProperties": false,
  "properties": {
    "query_id": { "type": "string", "description": "检索问题编号（可与画像样本对应）" },
    "standard_number": { "type": "string", "description": "本次检索使用的OSHA标准编号入口" },
    "risk_categories": { "type": "array", "items": { "type": "string", "pattern": "^R[1-9]$" }, "description": "本次检索使用的风险类别" },
    "items": {
      "type": "array",
      "description": "按得分排序的证据条目；找不到足够证据时为空数组",
      "items": {
        "$ref": "#/$defs/evidence_item"
      }
    },
    "empty_reason": { "type": ["string", "null"], "description": "证据不足时的原因，例如：知识库未覆盖该标准编号；禁止编造条款" }
  },
  "$defs": {
    "evidence_item": {
      "type": "object",
      "required": ["evidence_id", "document_id", "standard_number", "section", "text", "source_type", "source_url", "retrieved_at", "score"],
      "additionalProperties": false,
      "properties": {
        "evidence_id": { "type": "string", "description": "证据引用键，格式 regulation:<document_id>#<section>" },
        "document_id": { "type": "string", "description": "文档编号" },
        "standard_number": { "type": "string", "description": "OSHA标准编号，如 1910.269(a)(1)" },
        "section": { "type": "string", "description": "条款编号或章节位置" },
        "title": { "type": "string", "description": "条款或解释文件标题" },
        "text": { "type": "string", "description": "相关片段（官方原文）" },
        "source_type": { "type": "string", "enum": ["regulation", "interpretation", "data_definition", "field_manual", "archive"], "description": "来源类型；interpretation 必须单独标明，archive 不得作为当前建议的主要依据" },
        "source_url": { "type": "string", "format": "uri", "description": "可回到官方原文的链接" },
        "effective_date": { "type": ["string", "null"], "format": "date", "description": "生效日期" },
        "retrieved_at": { "type": "string", "format": "date", "description": "本项目下载该文件的日期" },
        "is_archived": { "type": "boolean", "description": "是否已归档的历史资料" },
        "score": { "type": "number", "description": "检索得分" },
        "rank": { "type": "integer", "minimum": 1, "description": "本次结果中的排序位置" }
      }
    }
  }
}
