{
  "project": "RiskProfile-Agent",
  "stage": "stage1-minimal-e2e",
  "version": "v0.1",
  "paths": {
    "knowledge_chunks": "knowledge/chunks/regulation_chunks.jsonl",
    "standard_mapping": "knowledge/chunks/standard_mapping.csv",
    "whitelist": "configs/agent_profile_whitelist.json",
    "runs": "runs",
    "manifests": "manifests"
  },
  "retrieval": {
    "top_k": 3,
    "min_score": 1
  },
  "review": {
    "max_points": 3,
    "model": "v0-rule-template",
    "model_note": "阶段8将替换为LLM；v0仅用于联调",
    "use_llm": false
  },
  "llm": {
    "provider": "dummy",
    "base_url": "",
    "api_key": "",
    "model": "",
    "temperature": 0.0,
    "max_tokens": 2048,
    "timeout": 120
  },
  "audit": {
    "max_rounds": 2,
    "forbidden_patterns": ["违反了", "违法", "必然", "必定", "应当处罚", "应予以处罚", "事故必然"]
  },
  "logging": {
    "format": "jsonl",
    "fields": ["ts_utc", "event", "run_id", "module", "sample_id", "input_tokens", "output_tokens", "latency_ms", "error"]
  }
}
