{
  "project": "RiskProfile-Agent",
  "stage": "stage8-orchestrator",
  "version": "v0.2",
  "paths": {
    "knowledge_chunks": "knowledge/chunks/regulation_chunks.jsonl",
    "standard_mapping": "knowledge/chunks/standard_document_mapping.csv",
    "whitelist": "configs/agent_profile_whitelist.json",
    "runs": "runs",
    "manifests": "manifests"
  },
  "retrieval": {
    "top_k": 3,
    "min_score": 1,
    "method": "tfidf-standard-restricted",
    "method_note": "按学生2阶段6冻结结论：TF-IDF 向量检索，k=3，知识库版本 5.0-frozen；候选集限定在标准编号固定对应表内"
  },
  "review": {
    "max_points": 3,
    "model": "v0-rule-template",
    "model_note": "阶段8支持 LLM（Qwen）与规则模板双模式；use_llm=true 且配置 qwen 时走 LLMClient",
    "use_llm": false,
    "fail_on_llm_error": true,
    "prompt_id": "review_agent_v1"
  },
  "llm": {
    "provider": "dummy",
    "base_url": "",
    "api_key": "",
    "model": "",
    "temperature": 0.0,
    "max_tokens": 2048,
    "timeout": 120
  },
  "audit": {
    "max_rounds": 2,
    "forbidden_patterns": ["违反了", "违法", "必然", "必定", "应当处罚", "应予以处罚", "事故必然"],
    "forbidden_rules_path": "configs/forbidden_claim_rules.yaml",
    "rules_note": "禁止性表达以 forbidden_claim_rules.yaml 为准；本处列表作为向后兼容的兜底"
  },
  "semantic_audit": {
    "use_llm": false,
    "prompt_id": "semantic_audit_v1",
    "fallback": "independent_rule",
    "model_note": "独立语义审查与确定性核对器分离；provider=qwen 时走 LLM，dummy 时使用独立规则回退"
  },
  "orchestrator": {
    "use_langgraph": true,
    "max_attempts": 2,
    "fail_close_on_empty_evidence": true,
    "write_run_index": true,
    "human_review_verdict": "DEFER",
    "note": "固定流程：profile -> retrieval -> review -> audit(确定性+语义) -> PASS / DEFER(转人工) / REJECT；超过最大轮次必须停止转人工"
  },
  "prompts": {
    "review_agent": "configs/prompts/review_agent_v1.md",
    "semantic_audit": "configs/prompts/semantic_audit_v1.md"
  },
  "registries": {
    "agent_registry": "configs/agent_registry.yaml",
    "prompt_registry": "configs/prompt_registry.yaml",
    "forbidden_claim_rules": "configs/forbidden_claim_rules.yaml"
  },
  "logging": {
    "format": "jsonl",
    "fields": ["ts_utc", "event", "run_id", "module", "sample_id", "input_tokens", "output_tokens", "latency_ms", "error"]
  }
}
