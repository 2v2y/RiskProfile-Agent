{
  "project": "RiskProfile-Agent",
  "stage": "stage9-baselines",
  "version": "v0.1",
  "retrieval": {
    "top_k": 3,
    "min_score": 1,
    "use_rag": true,
    "method": "student2-hybrid-faiss-bge",
    "fallback": "keyword"
  },
  "review": {
    "max_points": 3,
    "model": "qwen3.8-27b",
    "use_llm": false,
    "fail_on_llm_error": false,
    "prompt_id": "review_agent_v1",
    "model_note": "服务器正式运行前把 use_llm 改为 true，并配置 llm.provider=qwen"
  },
  "llm": {
    "provider": "dummy",
    "base_url": "",
    "api_key": "",
    "model": "",
    "temperature": 0.0,
    "max_tokens": 2048,
    "timeout": 120
  },
  "audit": {
    "max_rounds": 2,
    "forbidden_patterns": ["违反了", "违法", "必然", "必定", "应当处罚", "应予以处罚", "事故必然"],
    "forbidden_rules_path": "configs/forbidden_claim_rules.yaml"
  },
  "semantic_audit": {
    "use_llm": false,
    "prompt_id": "semantic_audit_v1",
    "fallback": "independent_rule"
  },
  "orchestrator": {
    "use_langgraph": true,
    "max_attempts": 2,
    "fail_close_on_empty_evidence": true,
    "write_run_index": true,
    "human_review_verdict": "DEFER"
  },
  "prompts": {
    "review_agent": "configs/prompts/review_agent_v1.md",
    "semantic_audit": "configs/prompts/semantic_audit_v1.md"
  },
  "registries": {
    "agent_registry": "configs/agent_registry.yaml",
    "prompt_registry": "configs/prompt_registry.yaml",
    "forbidden_claim_rules": "configs/forbidden_claim_rules.yaml"
  },
  "logging": {
    "format": "jsonl",
    "fields": ["ts_utc", "event", "run_id", "module", "sample_id", "input_tokens", "output_tokens", "latency_ms", "error"]
  }
}
