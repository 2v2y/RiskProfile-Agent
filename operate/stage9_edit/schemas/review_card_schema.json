{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review_card_schema.json",
  "title": "复核建议卡（Review Card）",
  "description": "最终复核建议卡格式（对应研究方案 14.4、15 节）。建议卡不是违法认定、处罚建议或事故预测。",
  "type": "object",
  "required": [
    "sample_id",
    "quarter",
    "ranking_cutoff",
    "frozen_risk",
    "profile_facts",
    "review_points",
    "official_citations",
    "missing_information",
    "evidence_ledger",
    "versions",
    "audit",
    "final_verdict"
  ],
  "additionalProperties": false,
  "properties": {
    "sample_id": { "type": "string", "description": "匿名样本编号" },
    "quarter": { "type": "string", "description": "所属季度" },
    "ranking_cutoff": { "type": "string", "format": "date", "description": "画像截止日" },
    "frozen_risk": {
      "type": "object",
      "description": "冻结风险分数、分位与排序来源（智能模块不得修改）",
      "required": ["risk_score", "risk_percentile", "ranking_source", "model_version", "score_evidence"],
      "additionalProperties": false,
      "properties": {
        "risk_score": { "type": ["number", "null"], "description": "固定M2模型风险分数" },
        "risk_percentile": { "type": ["number", "null"], "minimum": 0, "maximum": 1, "description": "季度内风险分位" },
        "ranking_source": { "type": "string", "description": "排序来源说明" },
        "model_version": { "type": "string", "description": "模型版本" },
        "score_evidence": { "type": "string", "description": "分数来源（SHA-256）" }
      }
    },
    "profile_facts": {
      "type": "array",
      "description": "已核对的历史事实（画像整理模块输出）",
      "items": { "$ref": "#/$defs/profile_fact" }
    },
    "review_points": {
      "type": "array",
      "description": "最多三项复核重点",
      "minItems": 1,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/review_point" }
    },
    "official_citations": {
      "type": "array",
      "description": "对应官方条款清单",
      "items": { "$ref": "#/$defs/citation" }
    },
    "missing_information": {
      "type": "array",
      "description": "缺失信息和不确定性（必须如实说明，不得猜测补全）",
      "items": {
        "type": "object",
        "required": ["field", "reason"],
        "additionalProperties": false,
        "properties": {
          "field": { "type": "string", "description": "缺失的画像字段或现场信息" },
          "reason": { "type": "string", "description": "缺失原因" }
        }
      }
    },
    "evidence_ledger": {
      "type": "array",
      "description": "逐条证据账本：每句话都要标明依据",
      "items": { "$ref": "#/$defs/ledger_entry" }
    },
    "versions": {
      "type": "object",
      "description": "智能模块、模型、提示词和知识库版本（可追溯）",
      "required": ["modules", "model", "knowledge"],
      "additionalProperties": false,
      "properties": {
        "modules": { "type": "array", "items": { "type": "string" } },
        "model": { "type": "object", "description": "模型名称与版本" },
        "prompts": { "type": "object", "description": "提示词版本" },
        "knowledge": { "type": "object", "description": "知识库版本与校验值" }
      }
    },
    "audit": {
      "type": "object",
      "description": "内容审查状态与逐条结果",
      "required": ["status", "attempts", "max_attempts"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["PASS", "DEFER", "REJECT"] },
        "attempts": { "type": "integer", "minimum": 0 },
        "max_attempts": { "type": "integer", "minimum": 1 },
        "per_claim": { "type": "array", "items": { "type": "object" }, "description": "逐条审计结果（详见 audit_result_schema.json）" }
      }
    },
    "final_verdict": { "type": "string", "enum": ["PASS", "DEFER", "REJECT"], "description": "通过 / 转人工 / 拒绝" }
  },
  "$defs": {
    "profile_fact": {
      "type": "object",
      "required": ["fact_id", "statement_zh", "field", "value", "provenance"],
      "additionalProperties": false,
      "properties": {
        "fact_id": { "type": "string" },
        "statement_zh": { "type": "string", "description": "中文事实陈述" },
        "field": { "type": "string", "description": "对应画像字段名" },
        "value": { "description": "画像字段原始值" },
        "provenance": { "type": "string", "pattern": "^profile:[A-Za-z0-9_]+$", "description": "证据账本引用，格式 profile:<field_name>" }
      }
    },
    "review_point": {
      "type": "object",
      "required": ["point_id", "focus_zh", "basis_profile_facts", "regulation_refs", "missing_field_info", "verification_instructions_zh"],
      "additionalProperties": false,
      "properties": {
        "point_id": { "type": "string" },
        "focus_zh": { "type": "string", "description": "建议人工关注什么" },
        "basis_profile_facts": { "type": "array", "items": { "type": "string" }, "description": "依据哪些画像事实（profile:<field>）" },
        "regulation_refs": { "type": "array", "items": { "type": "string" }, "description": "对应哪些官方标准（evidence_id）" },
        "missing_field_info": { "type": "array", "items": { "type": "string" }, "description": "缺少哪些现场信息" },
        "verification_instructions_zh": { "type": "string", "description": "建议人工怎样核实" }
      }
    },
    "citation": {
      "type": "object",
      "required": ["evidence_id", "document_id", "section", "source_url"],
      "additionalProperties": false,
      "properties": {
        "evidence_id": { "type": "string" },
        "document_id": { "type": "string" },
        "section": { "type": "string" },
        "source_url": { "type": "string" }
      }
    },
    "ledger_entry": {
      "type": "object",
      "required": ["claim_id", "statement_zh", "evidence_refs", "status"],
      "additionalProperties": false,
      "properties": {
        "claim_id": { "type": "string" },
        "statement_zh": { "type": "string", "description": "原子陈述（一句话）" },
        "evidence_refs": { "type": "array", "items": { "type": "string" }, "description": "profile: / regulation: / mapping: 三类引用" },
        "status": { "type": "string", "enum": ["supported", "unsupported", "deferred"] }
      }
    }
  }
}
