{
  "project": "RiskProfile-Agent",
  "stage": "stage9-full",
  "version": "1.0",
  "data_root_env": "RP_DATA_ROOT",
  "data": {
    "profiles_train_val": "origin_data/from_student1/student1/数据_分析数据/profiles_train_val.csv",
    "profile_supplement": "origin_data/from_student1/回复学生4_20260824/回复学生4_20260824/profile_supplement_8fields.csv",
    "knowledge_dir": "origin_data/from_student2/交付_学生4/交付_学生4/knowledge",
    "rag_retriever_path": "origin_data/from_student2/交付_学生4/交付_学生4/src/retrieval/rag_retriever.py",
    "r1r9_mapping": "origin_data/from_student1/回复学生4_20260824/回复学生4_20260824/standard_to_r1r9_mapping.csv",
    "benchmark_cases": "origin_data/from_student2/benchmark_cases.jsonl",
    "red_team_cases": "origin_data/from_student2/red_team_cases.jsonl",
    "gold": "origin_data/from_student3/student3/学生4需要的文件/benchmark_gold_restricted.jsonl",
    "manifest": "origin_data/from_student3/student3/学生4需要的文件/benchmark_manifest.json",
    "lookup": "origin_data/from_student3/student3/学生4需要的文件/case_8fields_lookup.jsonl",
    "whitelist": "origin_data/from_student1/回复学生4_20260824/回复学生4_20260824/agent_profile_whitelist.json"
  },
  "retrieval": {
    "top_k": 3,
    "use_rag": true,
    "fallback": "keyword",
    "method": "student2-hybrid-faiss-bge"
  },
  "review": {
    "max_points": 3,
    "model": "Qwen3.8-27B",
    "use_llm": false,
    "prompt_id": "review_agent_v1",
    "model_note": "服务器正式运行前把 use_llm 改为 true，并配置 llm.provider=qwen"
  },
  "llm": {
    "provider": "dummy",
    "base_url": "",
    "api_key": "",
    "model": "",
    "temperature": 0.0,
    "max_tokens": 2048,
    "timeout": 120
  },
  "audit": {
    "max_rounds": 2,
    "forbidden_patterns": ["违反了", "违法", "必然", "必定", "应当处罚", "应予以处罚", "事故必然"],
    "forbidden_rules_path": "operate/stage1/configs/forbidden_claim_rules.yaml"
  },
  "semantic_audit": {
    "use_llm": false,
    "prompt_id": "semantic_audit_v1"
  },
  "orchestrator": {
    "use_langgraph": true,
    "max_attempts": 2,
    "fail_close_on_empty_evidence": true,
    "human_review_verdict": "DEFER"
  },
  "prompts": {
    "review_agent": "operate/stage1/configs/prompts/review_agent_v1.md",
    "semantic_audit": "operate/stage1/configs/prompts/semantic_audit_v1.md"
  },
  "registries": {
    "agent_registry": "operate/stage1/configs/agent_registry.yaml",
    "prompt_registry": "operate/stage1/configs/prompt_registry.yaml",
    "forbidden_claim_rules": "operate/stage1/configs/forbidden_claim_rules.yaml"
  },
  "baselines": ["B0", "B1", "B2", "B3", "B4", "B5"],
  "ablation": {
    "full": "B5",
    "variants": [
      {"name": "full_minus_semantic_audit", "base": "B4", "removed": "semantic_audit"},
      {"name": "full_minus_retrieval", "base": "B1", "removed": "retrieval"},
      {"name": "full_minus_audit", "base": "B2", "removed": "audit"}
    ]
  },
  "evaluation": {
    "metrics": [
      "numeric_accuracy",
      "citation_validity",
      "citation_correctness",
      "evidence_support",
      "unsupported_claim",
      "traceability",
      "safe_refusal"
    ],
    "numeric_tolerance": 0.001,
    "random_seed": 0,
    "bootstrap": {"n_resamples": 2000, "confidence": 0.95}
  },
  "output": {
    "root": "results"
  }
}
