# 服务器运行 Qwen 时复制为 .env 并填写（切勿提交 .env 到 Git）。
# 全部默认值已与 config/experiment_config.json 一致；以下仅为覆盖项。
QWEN_BASE_URL=http://127.0.0.1:8000/v1
QWEN_API_KEY=EMPTY
# vLLM 实际暴露的模型 ID（含路径），不要写裸 Qwen3.8-27B
QWEN_MODEL=/DATA/models/Qwen3.8-27B
QWEN_TEMPERATURE=0.0
# vLLM max_model_len=8192：max_tokens=1024 + input<=6000，禁止回退到 2048
QWEN_MAX_TOKENS=1024
QWEN_TIMEOUT=120
# 输入 token 预算（默认 6000；与 max_tokens 之和需明显低于 8192）
# QWEN_INPUT_BUDGET=6000

# BGE 本地模型目录（默认 /DATA/models/bge-small-en-v1.5；离线加载，禁止联网下载）
# BGE_MODEL_PATH=/DATA/models/bge-small-en-v1.5

# 数据根目录：默认 = stage9_full 本身（data/ 已自包含）。
# 若把数据放到别处，RP_DATA_ROOT 须指向包含同样 data/ 布局的目录。
# RP_DATA_ROOT=/data/riskprofile/stage9_full
